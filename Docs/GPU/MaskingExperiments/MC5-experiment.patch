+cbuffer Parameters : register(b0) { uint Words, Offset, Initialize; };
+ByteAddressBuffer Candidate : register(t0);
+RWByteAddressBuffer Original : register(u0);
+
+// 게시가 확정된 후보만 원본 비트 마스크에 누적한다.
+[numthreads(64,1,1)]
+void main(uint id : SV_DispatchThreadID)
+{
+    // 처음 게시하는 section은 모든 비트가 살아 있는 상태로 취급한다.
+    if (id >= Words) return;
+    uint prior = Initialize ? 0xffffffffu : Original.Load(id * 4);
+
+    // CPU 선택 계산이나 readback 없이 이전 절단의 0을 보존한다.
+    Original.Store(id * 4, prior & Candidate.Load((Offset + id) * 4));
+}
