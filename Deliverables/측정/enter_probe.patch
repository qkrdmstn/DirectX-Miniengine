diff --git a/MiniEngine/MeshCutting/TempProbe.h b/MiniEngine/MeshCutting/TempProbe.h
new file mode 100644
index 0000000..d374b1e
--- /dev/null
+++ b/MiniEngine/MeshCutting/TempProbe.h
@@ -0,0 +1,66 @@
+// TEMPORARY: Enter cost measurement. Remove after measuring.
+#pragma once
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <map>
+#include <string>
+
+namespace MeshCutting
+{
+    namespace TempProbe
+    {
+        struct Entry { double ms = 0.0; uint32_t count = 0; };
+        inline std::map<std::string, Entry>& Table() { static std::map<std::string, Entry> t; return t; }
+        inline std::string& Path() { static std::string p; return p; }
+        inline std::string& Notes() { static std::string n; return n; }
+        inline bool& Enabled() { static bool e = false; return e; }
+        inline double Now()
+        {
+            return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now().time_since_epoch()).count();
+        }
+        inline void Note(const std::string& s) { if (Enabled()) Notes() += s + "\n"; }
+
+        class Scope
+        {
+        public:
+            explicit Scope(const char* name)
+            {
+                if (!Enabled()) return;
+                m_On = true;
+                m_PrevSize = Path().size();
+                Path() += "/";
+                Path() += name;
+                m_Start = Now();
+            }
+            ~Scope()
+            {
+                if (!m_On) return;
+                Entry& e = Table()[Path()];
+                e.ms += Now() - m_Start;
+                ++e.count;
+                Path().resize(m_PrevSize);
+            }
+        private:
+            bool m_On = false;
+            size_t m_PrevSize = 0;
+            double m_Start = 0.0;
+        };
+
+        inline void Dump(const char* file, int run, double frameMs)
+        {
+            FILE* f = nullptr;
+            if (fopen_s(&f, file, "a") != 0 || f == nullptr) return;
+            fprintf(f, "=== run %d  frameDelta %.3f ms\n", run, frameMs);
+            fputs(Notes().c_str(), f);
+            for (const auto& entry : Table())
+                fprintf(f, "%9.3f ms  x%-3u %s\n", entry.second.ms, entry.second.count, entry.first.c_str());
+            fclose(f);
+            Table().clear();
+            Notes().clear();
+        }
+    }
+}
+#define TEMP_PROBE_CAT2(a, b) a##b
+#define TEMP_PROBE_CAT(a, b) TEMP_PROBE_CAT2(a, b)
+#define TEMP_PROBE(name) ::MeshCutting::TempProbe::Scope TEMP_PROBE_CAT(tempProbe_, __LINE__)(name)
